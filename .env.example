##############################################################################
# ADEBES — variables d'environnement
#
# Copiez ce fichier en `.env.local` pour le développement, et déclarez les
# mêmes variables dans Vercel (Settings → Environment Variables) pour la
# production.
#
# `.env.local` est ignoré par Git : aucune clé ne doit jamais être commitée.
#
# ⚠️  Dans Vercel, une variable créée **sans valeur** n'est pas « absente » :
#     elle vaut une chaîne vide. Ne créez une variable que si vous la
#     renseignez ; sinon, supprimez-la et laissez la valeur par défaut jouer.
##############################################################################

# --- Site ------------------------------------------------------------------
# URL canonique. Sert aux métadonnées Open Graph, au sitemap, aux URL de
# partage et aux données structurées.
#
# La barre oblique finale et l'absence de protocole sont tolérées. Si la
# valeur est vide ou invalide, le site retombe sur l'URL Vercel du projet,
# puis sur https://adebesgroup.com — le build n'échoue jamais pour autant.
NEXT_PUBLIC_SITE_URL="https://adebesgroup.com"


# --- Envoi des formulaires (Resend) ----------------------------------------
# Sans ces trois variables, les formulaires de contact et de bénévolat
# affichent un message invitant à passer par e-mail ou WhatsApp — ils ne
# prétendent jamais avoir envoyé un message qui n'est pas parti.
#
# 1. Créez un compte sur https://resend.com
# 2. Vérifiez le domaine d'envoi (adebes.cm) dans Resend
# 3. Générez une clé API et renseignez-la ci-dessous
RESEND_API_KEY=""

# Expéditeur des e-mails. Le domaine doit être vérifié dans Resend.
CONTACT_EMAIL_FROM="Site ADEBES <site@adebes.cm>"

# Destinataire des messages reçus. Par défaut : l'adresse de contact publique.
CONTACT_EMAIL_TO="contact@adebes.cm"


# --- Réseaux sociaux -------------------------------------------------------
# Tant qu'une URL est vide, l'icône correspondante s'affiche grisée avec la
# mention « compte à venir » — jamais un lien mort (constat #7 de l'audit).
NEXT_PUBLIC_FACEBOOK_URL=""
NEXT_PUBLIC_INSTAGRAM_URL=""
NEXT_PUBLIC_TIKTOK_URL=""


# --- Supabase --------------------------------------------------------------
# Base de données, authentification et stockage des médias.
#
# L'URL et la clé anon sont publiques par nature : elles partent dans le
# navigateur. Ce qui protège les données n'est pas leur secret, ce sont les
# politiques RLS actives sur toutes les tables — la clé anon ne voit que le
# contenu publié.
#
# Relevez ces deux valeurs dans Supabase → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_URL="https://vulqavwbfybwqrufgctj.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_F0U7r0lwENE0t9jLg997bw_vjGLUE_U"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Clé de service : elle contourne TOUTES les politiques RLS.
#
# Jamais préfixée NEXT_PUBLIC_ (elle partirait dans le navigateur), jamais
# commitée, jamais importée dans un composant client. Un seul fichier la lit :
# src/infrastructure/supabase/clients/admin.ts
SUPABASE_SERVICE_ROLE_KEY=""


# --- Dashboard -------------------------------------------------------------
# E-mail du premier super administrateur, créé par le script de seed.
# C'est le compte qui pourra ensuite inviter les autres.
SEED_SUPER_ADMIN_EMAIL=""
